[Unit]
Description=Clipero app (servidor local)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/Clipero
ExecStart=@CLIPERO@ app --port 8765
Restart=always
RestartSec=5
Environment=CLIPERO_HOME=%h/Clipero
Environment=PATH=%h/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
